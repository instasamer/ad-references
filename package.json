{
  "name": "ad-references",
  "version": "1.0.0",
  "description": "Herramienta para buscar referencias de publicidad por concepto",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "seed": "node server/seed.js",
    "install-all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "googleapis": "^171.4.0",
    "multer": "^1.4.5-lts.1",
    "puppeteer": "^22.15.0",
    "sql.js": "^1.10.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
