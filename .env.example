# === API Keys ===
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# === Server ===
PORT=3000
BASE_URL=http://localhost:3000

# === Google Maps Scraping ===
# Target location and business type
SEARCH_LOCATION=Málaga, España
SEARCH_QUERY=restaurantes
SEARCH_RADIUS_KM=10
MAX_RESULTS_PER_RUN=50

# === WhatsApp ===
# Leave empty - QR code auth on first run
WHATSAPP_SESSION_PATH=./data/whatsapp-session

# === Pipeline Schedule ===
# Cron expression: default runs daily at 9am
CRON_SCHEDULE=0 9 * * *
