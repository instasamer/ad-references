# === API Keys ===
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# === Server ===
PORT=3000
BASE_URL=http://tu-dominio.com

# === Google Maps Scraping ===
SEARCH_LOCATION=Málaga, España
SEARCH_QUERY=restaurantes
SEARCH_RADIUS_KM=10
MAX_RESULTS_PER_RUN=50

# === WhatsApp ===
WHATSAPP_SESSION_PATH=./data/whatsapp-session

# === Pipeline ===
CRON_SCHEDULE=0 9 * * *
# Modo test: empieza con pocos negocios (true por defecto)
TEST_MODE=true
TEST_BATCH_SIZE=5

# === Datos de Facturación (Autónoma) ===
INVOICE_BUSINESS_NAME=Tu Nombre Completo
INVOICE_NIF=12345678A
INVOICE_ADDRESS=Calle Ejemplo 123
INVOICE_CITY=Málaga
INVOICE_POSTAL_CODE=29001
INVOICE_EMAIL=tu@email.com
INVOICE_PHONE=+34612345678
INVOICE_IBAN=ES00 0000 0000 0000 0000 0000
INVOICE_BANK_NAME=Tu Banco
# IRPF: 7% primeros 2 años de autónoma, luego 15%
INVOICE_IRPF_RATE=0.07
